# Copy to supabase/functions/.env for local dev. In production: `supabase secrets set KEY=value`.
INTERNAL_FN_SECRET=local-dev-internal-secret-not-for-prod   # must match the Vault secret internal_fn_secret
VAPID_PUBLIC_KEY=        # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
APP_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_xxx
# Optional: point at a mock Paystack API for local testing (default https://api.paystack.co)
# PAYSTACK_API_URL=http://host.docker.internal:4010
# Paystack needs an email per transaction; buyers sign in by phone, so we synthesise one.
BUYER_EMAIL_DOMAIN=buyers.declutter.ng
